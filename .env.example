# Copy to .env and fill in. .env is git-ignored and never baked into an image.
# Every variable the compose file references is listed here.

# ---- Database ---------------------------------------------------------------
# SQL Server rejects a weak SA password outright: 8+ characters with upper,
# lower, digits and a symbol. Used by both the db and api services.
DB_PASSWORD=Change_this_Password1!

# ---- Auth -------------------------------------------------------------------
# JWT signing key. Any long random string; the API refuses to start in
# Production without one. Generate with: openssl rand -base64 48
JWT_KEY=replace-with-a-long-random-signing-key-at-least-32-chars

# ---- GSTIN verification -----------------------------------------------------
# Mock (default) never calls the real registry, so demos and tests never spend
# a credit. Set to GstinApi plus a key for live verification.
GSTIN_PROVIDER=Mock
GSTIN_API_KEY=

# ---- Email ------------------------------------------------------------------
# Log (default) writes the approval email to the API logs and sends nothing.
# Smtp routes through Mailtrap or any relay; SendGrid uses the API key.
EMAIL_PROVIDER=Log
EMAIL_FROM=no-reply@saakh.app
SENDGRID_API_KEY=
SMTP_HOST=
SMTP_PORT=2525
SMTP_USER=
SMTP_PASSWORD=

# ---- Hosting ----------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Production
# Origin the browser loads the app from. Used for CORS when the API is called
# directly on :5000 rather than through the web container's proxy.
WEB_ORIGIN=http://localhost

# Let the API apply pending migrations when it starts. Safe for this
# single-replica stack and it means `docker compose up` needs no second command.
# Set to false where more than one API instance runs, and apply the schema once
# with the migrate bundle instead.
MIGRATE_ON_STARTUP=true
