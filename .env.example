# Copy to .env and fill in. .env is git-ignored and never baked into an image.
# Every variable the compose file references is listed here.

# ---- Database ---------------------------------------------------------------
# SQL Server rejects a weak SA password outright: 8+ characters with upper,
# lower, digits and a symbol. Used by both the db and api services.
DB_PASSWORD=Change_this_Password1!

# ---- Auth -------------------------------------------------------------------
# JWT signing key. Any long random string; the API refuses to start in
# Production without one. Generate with: openssl rand -base64 48
JWT_KEY=replace-with-a-long-random-signing-key-at-least-32-chars

# ---- GSTIN verification -----------------------------------------------------
# Mock (default) never calls the real registry, so demos and tests never spend
# a credit. Set to GstinApi plus a key for live verification.
GSTIN_PROVIDER=Mock
GSTIN_API_KEY=

# ---- Email ------------------------------------------------------------------
# Log (default) writes the approval email to the API logs and sends nothing.
# Smtp routes through Mailtrap or any relay; SendGrid uses the API key.
EMAIL_PROVIDER=Log
EMAIL_FROM=no-reply@saakh.app
SENDGRID_API_KEY=
SMTP_HOST=
SMTP_PORT=2525
SMTP_USER=
SMTP_PASSWORD=

# ---- Hosting ----------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Production
# Origin the browser loads the app from. Used for CORS when the API is called
# directly on :5000 rather than through the web container's proxy.
WEB_ORIGIN=http://localhost

# Let the API apply pending migrations when it starts. Safe for this
# single-replica stack and it means `docker compose up` needs no second command.
# Set to false where more than one API instance runs, and apply the schema once
# with the migrate bundle instead.
MIGRATE_ON_STARTUP=true

# Return the signup OTP in the API response, because the free stack has no SMS
# gateway and the code otherwise only reaches the API log. This is what makes the
# demo completable. Set to false for a real deployment: with it on, anyone can
# confirm any phone number, which is the whole point of the check.
REVEAL_OTP=true

# ---- SMS (the signup OTP) ---------------------------------------------------
# Log (default) sends nothing: the code goes to the API log and back to the signup
# form. That makes the demo completable and makes phone verification meaningless.
# Set a real gateway and the code goes to the handset instead — and stops being
# returned to the form, whatever REVEAL_OTP says.
#
#   Email     — free and real: the code goes to the signup email address. Needs
#               EMAIL_PROVIDER=Smtp with a free Brevo/Mailtrap SMTP account below.
#               Verifies an inbox rather than a handset, and the form says so.
#   Fast2Sms  — India. Its API needs a one-off 100 INR top-up before any route works,
#               and route=otp additionally needs website verification
#   Msg91     — India, needs SMS_API_KEY and a DLT-approved SMS_TEMPLATE_ID
#   Twilio    — international, needs SMS_ACCOUNT_SID, SMS_API_KEY, SMS_FROM_NUMBER
SMS_PROVIDER=Log
SMS_API_KEY=
SMS_TEMPLATE_ID=
SMS_ACCOUNT_SID=
SMS_FROM_NUMBER=
