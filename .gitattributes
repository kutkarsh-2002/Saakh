# Normalize to LF in the repository, and let Git pick the working-tree ending.
* text=auto

# Shell scripts must keep LF in the working tree too, whatever core.autocrlf is
# set to locally. A .sh checked out with CRLF fails on its own shebang —
# "bad interpreter: /usr/bin/env bash^M" — both on Linux and in Git Bash, which
# is exactly where deploy/azure/*.sh is meant to run.
*.sh text eol=lf

# Same reason: these are read by Linux containers and tooling.
Dockerfile text eol=lf
*.conf text eol=lf
*.conf.template text eol=lf
.env.example text eol=lf
docker-compose.yml text eol=lf

# Binary, so never touched.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary
