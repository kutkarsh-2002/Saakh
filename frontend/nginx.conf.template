# nginx config template for the Angular container.
#
# The SPA and the API are served from one origin: nginx reverse-proxies /api and
# /hubs to the api service. That keeps the browser on a single origin, so there is
# no CORS preflight and no API hostname baked into the JavaScript bundle at build
# time.
#
# The upstream is a variable because it differs by host. Under compose it is the
# service name and its own port, api:5000, and the Host header can stay whatever
# the browser sent. Azure Container Apps differs twice over: nginx cannot resolve
# the bare app name at startup, so the upstream must be the app's full internal
# FQDN; and ingress routes by Host header, so forwarding the browser's host would
# send the request straight back to the web app. API_HOST is therefore set to the
# same FQDN there. It defaults to the literal text $host, which envsubst leaves in
# the output for nginx to expand as usual.
#
# API_SCHEME is the third one: http on a compose network, https on Container Apps.
# Express environments there refuse allowInsecure, so plain HTTP to the API is
# answered with a 301 to HTTPS that the browser would be handed. For https
# upstreams nginx must also send SNI, which ingress needs to pick the app.
#
# The nginx image expands this file from /etc/nginx/templates into conf.d at
# startup. NGINX_ENVSUBST_FILTER (set in the Dockerfile) restricts expansion to
# the API_* variables, so nginx's own $uri, $scheme and friends survive untouched.

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Only matters when API_SCHEME is https; ingress routes on the SNI name.
    proxy_ssl_server_name on;

    # Vendors are often on patchy mobile data, so text assets are compressed.
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    # Hashed build output never changes under the same name, so it is immutable.
    location ~* \.(?:js|css|woff2?|svg|png|jpg|jpeg|webp|ico)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location /api/ {
        proxy_pass ${API_SCHEME}://${API_UPSTREAM}/api/;
        proxy_http_version 1.1;
        proxy_set_header Host ${API_HOST};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Evidence uploads are up to 10 MB each.
        client_max_body_size 40m;
        proxy_read_timeout 120s;
    }

    # SignalR needs the connection upgraded for WebSocket transport.
    location /hubs/ {
        proxy_pass ${API_SCHEME}://${API_UPSTREAM}/hubs/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host ${API_HOST};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # A long read timeout keeps an idle hub connection from being dropped.
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }

    location /swagger/ {
        proxy_pass ${API_SCHEME}://${API_UPSTREAM}/swagger/;
        proxy_set_header Host ${API_HOST};
    }

    location /health {
        proxy_pass ${API_SCHEME}://${API_UPSTREAM}/health;
        proxy_set_header Host ${API_HOST};
    }

    # Every other path is an Angular route, so it falls through to the shell.
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }
}
